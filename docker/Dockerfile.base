# Isaac Sim base container: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/isaac-sim
# Please check the NGC container page for license information.

# Base image
ARG ISAACSIM_BASE_IMAGE_ARG=nvcr.io/nvidian/isaac-sim
ARG ISAACSIM_VERSION_ARG=latest-release-6-0
FROM ${ISAACSIM_BASE_IMAGE_ARG}:${ISAACSIM_VERSION_ARG} AS base
ARG ISAACSIM_VERSION_ARG
ENV ISAACSIM_VERSION=${ISAACSIM_VERSION_ARG}

# Set default RUN shell to bash
SHELL ["/bin/bash", "-c"]

# Adds labels to the Dockerfile
LABEL version="2.1.1"
LABEL description="Dockerfile for building and running the Isaac Lab framework inside Isaac Sim container image."

# Arguments
# Path to Isaac Sim root folder
ARG ISAACSIM_ROOT_PATH_ARG
ENV ISAACSIM_ROOT_PATH=${ISAACSIM_ROOT_PATH_ARG}
# Path to the Isaac Lab directory
ARG ISAACLAB_PATH_ARG
ENV ISAACLAB_PATH=${ISAACLAB_PATH_ARG}
# Home dir of the runtime docker user, typically '/root'
ARG DOCKER_USER_HOME_ARG
ENV DOCKER_USER_HOME=${DOCKER_USER_HOME_ARG}
ENV HOME=${DOCKER_USER_HOME}

# Set environment variables
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

# Install uv-managed CPython (used only by the ephemeral apt-deps step below;
# the project venv is built on the Isaac Sim bundled interpreter) into a shared,
# root-owned location instead of the runtime user's home, so it stays out of the
# ``chown -R ${DOCKER_USER_HOME}`` and doesn't trigger an overlayfs copy-up.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python

# Base image may end with a non-root user; switch to root for system-level
# setup and package installation.
USER root

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    ncurses-term \
    cmake \
    git \
    git-lfs \
    wget

# Install the Carbonite environment shim that serializes glibc environment
# access across Kit worker threads. Use /etc/ld.so.preload because Isaac Sim's
# python.sh overwrites LD_PRELOAD before launching the interpreter.
COPY docker/scripts/install_carb_env_shim.sh /tmp/install_carb_env_shim.sh
RUN /bin/bash /tmp/install_carb_env_shim.sh "${ISAACSIM_ROOT_PATH}" && \
    rm /tmp/install_carb_env_shim.sh

# arm64-only build deps:
# - imgui-bundle has no prebuilt arm64 wheel; needs GL/X11 dev headers.
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends \
        libgl1-mesa-dev libopengl-dev libglx-dev \
        libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev; \
    fi

# Bring in the uv binary (pinned) used for the dependency install below.
COPY --from=ghcr.io/astral-sh/uv:0.9.4 /uv /uvx /usr/local/bin/

# copy files necessary for installing Isaac Lab and its dependencies
# this way we minimize the chance of cache invalidation on file edits
# (pyproject.toml + source/ are the inputs the install CLI resolves against).
# ``--chown=1000:1000`` (numeric, since the isaaclab user is created later) sets
# ownership as the files are written, so we avoid a slow recursive ``chown`` over
# source/ (incl. the bulky isaaclab_assets/data) on overlayfs.
COPY --chown=1000:1000 ../isaaclab.* ../environment.yml ../pyproject.toml ../uv.lock ${ISAACLAB_PATH}/
COPY --chown=1000:1000 ../tools/ ${ISAACLAB_PATH}/tools/
COPY --chown=1000:1000 ../source/ ${ISAACLAB_PATH}/source/

# Fix the line endings for the shell scripts (Windows git may add \r)
RUN find ${ISAACLAB_PATH} -type f -name "*.sh" -exec sed -i 's/\r$//' {} +

# Ensure isaaclab.sh has execute permissions
RUN chmod +x ${ISAACLAB_PATH}/isaaclab.sh

# Set up a symbolic link between the installed Isaac Sim root folder and _isaac_sim in the Isaac Lab directory
RUN ln -sf ${ISAACSIM_ROOT_PATH} ${ISAACLAB_PATH}/_isaac_sim

# Install apt dependencies that extensions declare in their extension.toml.
# This needs root and the ``toml`` module; ``uv run --no-project --with toml``
# gives an ephemeral interpreter with toml without touching the bundled Python or
# the project venv, so the venv can be built later as the non-root user.
RUN uv run --no-project --with toml python ${ISAACLAB_PATH}/tools/install_deps.py apt ${ISAACLAB_PATH}/source && \
    apt-get -y autoremove && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# for singularity usage, have to create the directories that will binded
RUN mkdir -p ${ISAACSIM_ROOT_PATH}/kit/cache && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/ov && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/pip && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/nvidia/GLCache &&  \
    mkdir -p ${DOCKER_USER_HOME}/.nv/ComputeCache && \
    mkdir -p ${DOCKER_USER_HOME}/.nvidia-omniverse/logs && \
    mkdir -p ${DOCKER_USER_HOME}/.local/share/ov/data && \
    mkdir -p ${DOCKER_USER_HOME}/Documents

# for singularity usage, create NVIDIA binary placeholders
RUN touch /bin/nvidia-smi && \
    touch /bin/nvidia-debugdump && \
    touch /bin/nvidia-persistenced && \
    touch /bin/nvidia-cuda-mps-control && \
    touch /bin/nvidia-cuda-mps-server && \
    touch /etc/localtime && \
    mkdir -p /var/run/nvidia-persistenced && \
    touch /var/run/nvidia-persistenced/socket

# On arm64, nlopt 2.6.2 has no wheel and is built from source by the dependency
# sync further below, which needs swig. It is purged again once the sync is done
# so it does not survive into the final image.
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends swig && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# aliasing isaaclab.sh and python for convenience
RUN echo "export ISAACLAB_PATH=${ISAACLAB_PATH}" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias isaaclab=${ISAACLAB_PATH}/isaaclab.sh" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias tensorboard='${ISAACLAB_PATH}/.venv/bin/python -m tensorboard'" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "export TZ=$(date +%Z)" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "shopt -s histappend" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "PROMPT_COMMAND='history -a'" >> ${DOCKER_USER_HOME}/.bashrc

# Create the non-root runtime user. The source tree is already owned by uid 1000
# (via COPY --chown above) and the dependency install runs as this user below, so
# we never recursively chown source/ or the .venv. The uv-managed Python lives in
# /opt, not the home, so only the small runtime home needs chowning. uid/gid 1000
# match GitHub runner bind mounts; --non-unique covers base images with a 1000 user.
RUN groupadd --non-unique --gid 1000 isaaclab \
 && useradd --non-unique --uid 1000 --gid 1000 -M -l -s /bin/bash -d ${DOCKER_USER_HOME} isaaclab

# Open up traversal of the Isaac Sim root for non-root users (inner Isaac Sim
# files keep their original permissions), and keep the runtime home closed and
# owned by the runtime user. Also pre-create the uv-managed Python dir owned by
# uid 1000 so any uv step run as isaaclab can write into it.
RUN chmod 755 ${ISAACSIM_ROOT_PATH} && \
    chown -R isaaclab:isaaclab ${DOCKER_USER_HOME} && \
    chmod 750 ${DOCKER_USER_HOME} && \
    mkdir -p ${UV_PYTHON_INSTALL_DIR} && \
    chown -R isaaclab:isaaclab ${UV_PYTHON_INSTALL_DIR}

# Activate the uv environment for all shells. With ``VIRTUAL_ENV`` set and the
# venv's bin on ``PATH``, ``isaaclab.sh`` selects ``$VIRTUAL_ENV/bin/python`` and
# still sources the Isaac Sim env setup script for native libs, and bare
# ``python``/``pip`` resolve to the uv environment.
ENV UV_PROJECT_ENVIRONMENT=${ISAACLAB_PATH}/.venv
ENV VIRTUAL_ENV=${ISAACLAB_PATH}/.venv
ENV PATH=${ISAACLAB_PATH}/.venv/bin:${PATH}

USER isaaclab

# Install Isaac Lab and its dependencies, as the non-root user so the venv is
# created already-owned (see the chown note above). ``uv sync`` resolves nothing:
# it materializes exactly what ``uv.lock`` pins, so the image matches a local
# source checkout package-for-package. Do NOT swap this for a plain
# ``uv pip install``/``isaaclab.sh --install``; those re-resolve at build time and
# let the image drift away from the lock.
#
# The venv is built on uv's own managed CPython 3.12 (NOT the Isaac Sim bundled
# interpreter) and WITHOUT --system-site-packages. CPython 3.12 is ABI-stable
# across patch releases, so Isaac Sim's ``cp312`` native extensions
# (``isaacsim``/``omni``, exposed at run time via ``isaaclab.sh`` sourcing
# ``setup_*_env.sh`` on PYTHONPATH) load fine on the managed interpreter -- this
# mirrors the working local source setup. Installing into the bundled interpreter
# instead lays down a mixed ``pxr``: ``usd-core`` and ``usd-exchange`` both ship a
# ``pxr/`` tree and clobber each other's shared objects in an order that links
# ``pxr.Usd`` against one USD build and ``pxr.UsdGeom`` against another, so
# importing them together re-registers USD/Tf C++ types and crashes with
# ``No to_python converter for ...UsdTimeCode``. On arm64, nlopt 2.6.2 (pinned via
# isaacteleop) has no wheel and is built with --no-build-isolation.
#
# The args select which extras to install; do NOT add ``--extra isaacsim`` (Isaac
# Sim is the binary base image, not a pip package). Override to change the extras.
ARG ISAACLAB_UV_SYNC_ARGS="--extra all --extra rtx --extra ov"
# Changing this token re-runs the sync below without discarding the system layers
# above it. ``buildnpush.py`` sets it for ``-d/--deps`` so a dependency rebuild
# cannot silently reuse a previously resolved environment.
ARG DEPS_CACHE_BUST=0
RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/uv,uid=1000,gid=1000 \
    echo "dependency sync token: ${DEPS_CACHE_BUST}" && \
    cd ${ISAACLAB_PATH} && \
    uv venv --python 3.12 ${ISAACLAB_PATH}/.venv && \
    if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        uv pip install setuptools wheel numpy && \
        uv pip install --no-build-isolation nlopt==2.6.2; \
    fi && \
    uv sync ${ISAACLAB_UV_SYNC_ARGS}

# Isaac Sim's pip prebundle can appear before the project venv on PYTHONPATH
# after ``setup_conda_env.sh`` is sourced. Its stale ``typing_extensions`` copy
# breaks modern W&B/Pydantic imports, so let the venv-provided package win.
USER root

RUN find ${ISAACSIM_ROOT_PATH}/extscache -path "*/pip_prebundle/typing_extensions.py" -delete

# The arm64 nlopt source build is done, so drop its swig build dependency again.
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        apt-get purge -y --auto-remove swig && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/* && \
        if command -v swig >/dev/null 2>&1; then exit 1; fi; \
    fi

USER isaaclab

# copy the rest of the files
COPY --chown=isaaclab:isaaclab ../ ${ISAACLAB_PATH}/

USER root

# Pre-create every docker-compose named-volume mount point and hand it to the
# non-root runtime user. docker-compose.yaml is the single source of truth for
# the list; docker/utils/volume_mounts.py parses it so the paths are not
# duplicated here. A fresh named volume inherits ownership from the image
# directory at its mount path; if that directory is missing or root-owned, the
# volume comes up root-owned and the isaaclab user cannot write it (e.g.
# PermissionError creating logs/, or omni.datastore lock failures under
# kit/cache). set -o pipefail makes a parse failure abort the build:
# volume_mounts.py exits non-zero on an empty/unresolved list and grep exits
# non-zero if no paths are produced, so the build fails here rather than
# silently shipping an unprepared mount point.
RUN set -o pipefail \
 && export DOCKER_ISAACSIM_ROOT_PATH="${ISAACSIM_ROOT_PATH}" \
           DOCKER_ISAACLAB_PATH="${ISAACLAB_PATH}" \
           DOCKER_USER_HOME="${DOCKER_USER_HOME}" \
 && dirs="$(${ISAACLAB_PATH}/isaaclab.sh -p ${ISAACLAB_PATH}/docker/utils/volume_mounts.py | grep '^/')" \
 && mkdir -p ${dirs} \
 && chown -R isaaclab:isaaclab ${dirs}

USER isaaclab

# make working directory as the Isaac Lab directory
# this is the default directory when the container is run
WORKDIR ${ISAACLAB_PATH}
