{
  "logical_transition": {
    "action_applied": {
      "dtype": "bool",
      "shape": ["batch", 1]
    },
    "behavior_action": {
      "meaning": "action sampled by the behavior policy and stored in replay",
      "shape": ["batch", "action_width"]
    },
    "context_changed": {
      "dtype": "bool",
      "shape": ["batch", 1]
    },
    "environment_reward": {
      "shape": ["batch", 1],
      "timing": "transition"
    },
    "final_observation": {
      "meaning": "pre-reset reached state for same-step done rows",
      "shape": ["batch", "named_fields"]
    },
    "final_observation_valid": {
      "dtype": "bool",
      "shape": ["batch", 1]
    },
    "motion": {
      "fields": ["clip_id", "episode_relative_step", "reference_time_seconds", "reset_source", "tail_valid"],
      "shape": ["batch", "named_fields"]
    },
    "processed_action": {
      "meaning": "action after environment normalization, clipping, delay, and controller preprocessing",
      "shape": ["batch", "action_width"]
    },
    "provider_versions": {
      "fields": ["observation_layout", "normalizer", "reward_provider", "motion_bank"],
      "shape": ["batch", "named_fields"]
    },
    "reached_observation": {
      "selection": "final when same-step done and valid, otherwise returned",
      "shape": ["batch", "named_fields"]
    },
    "returned_observation": {
      "meaning": "literal environment step return, post-reset on same-step done",
      "shape": ["batch", "named_fields"]
    },
    "terminated": {
      "dtype": "bool",
      "shape": ["batch", 1]
    },
    "transition_evidence": {
      "meaning": "raw named environment-owned facts before scalar weights",
      "shape": ["batch", "evidence_width"]
    },
    "truncated": {
      "dtype": "bool",
      "shape": ["batch", 1]
    }
  },
  "motion_bank": {
    "flat_frame_axis": "frames from clip i occupy [offsets[i], offsets[i + 1])",
    "required_identity": [
      "source_content_hash",
      "source_skeleton_hash",
      "robot_layout_hash",
      "materializer_version",
      "time_policy"
    ],
    "required_metadata": ["clip_id", "offsets", "frame_count", "source_fps", "split", "validity"],
    "sampling_law": "requested windows never cross offsets and exact requested cardinality is returned or construction fails"
  },
